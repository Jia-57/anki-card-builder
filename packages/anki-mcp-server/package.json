{
  "name": "@cardbuilder/anki-card-builder",
  "version": "0.1.0",
  "description": "Independent Anki Card Builder fork of ankimcp/anki-mcp-server with nested deck creation support",
  "author": "Anatoly Tarnavsky",
  "contributors": [
    "Jia-57"
  ],
  "private": false,
  "license": "MIT",
  "main": "dist/main-http.js",
  "bin": {
    "anki-card-builder-mcp": "bin/ankimcp.js"
  },
  "scripts": {
    "build": "nest build",
    "prepack": "npm run build",
    "start:dev:stdio": "nest start --watch --entryFile main-stdio",
    "start:prod:stdio": "node dist/main-stdio.js",
    "start:prod:http": "node dist/main-http.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:create-deck": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/mcp/primitives/essential/tools/__tests__/create-deck.tool.spec.ts --runInBand",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@rekog/mcp-nest": "^2.0.6",
    "async-mutex": "^0.5.0",
    "commander": "^15.0.0",
    "ipaddr.js": "^2.5.0",
    "ky": "^2.1.0",
    "mime": "^4.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "remark-parse": "^11.0.0",
    "rxjs": "^7.8.2",
    "unified": "^11.0.5",
    "update-notifier": "^7.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "2.7.0",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@types/update-notifier": "^6.0.8",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**",
      "!src/test-fixtures/**",
      "!src/main.ts",
      "!src/main-stdio.ts",
      "!src/main-http.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist",
      "<rootDir>/dist-stdio",
      "<rootDir>/dist-http"
    ],
    "forceExit": true
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jia-57/anki-card-builder.git",
    "directory": "packages/anki-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Jia-57/anki-card-builder/issues"
  },
  "homepage": "https://github.com/Jia-57/anki-card-builder#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anki",
    "flashcards",
    "spaced-repetition",
    "ai",
    "claude",
    "chatgpt",
    "ankiconnect"
  ],
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
